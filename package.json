{
  "name": "master-landing-page-template",
  "version": "1.0.0",
  "description": "Production-ready landing page template with Next.js 15, Tailwind CSS, and Firebase",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "next lint",
    "type-check": "tsc --noEmit",
    "test": "vitest",
    "test:ui": "vitest --ui",
    "test:run": "vitest run",
    "test:coverage": "vitest run --coverage",
    "test:e2e": "playwright test",
    "test:e2e:ui": "playwright test --ui",
    "test:e2e:debug": "playwright test --debug",
    "test:e2e:headed": "playwright test --headed",
    "snyk-test": "snyk test --severity-threshold=high",
    "snyk-monitor": "snyk monitor"
  },
  "dependencies": {
    "@emailjs/browser": "^4.4.1",
    "firebase": "^10.7.1",
    "lucide-react": "^0.294.0",
    "next": "^15.5.10",
    "react": "^18.2.0",
    "react-dom": "^18.2.0",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@playwright/test": "^1.58.2",
    "@tailwindcss/typography": "^0.5.19",
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.2",
    "@testing-library/user-event": "^14.6.1",
    "@types/node": "20.19.25",
    "@types/react": "18.3.27",
    "@types/react-dom": "^18.2.18",
    "@vitejs/plugin-react": "^5.1.4",
    "@vitest/ui": "^4.0.18",
    "autoprefixer": "^10.4.16",
    "eslint": "^8.56.0",
    "eslint-config-next": "14.0.4",
    "happy-dom": "^20.8.3",
    "jsdom": "^28.1.0",
    "postcss": "^8.4.32",
    "snyk": "^1.1303.0",
    "tailwindcss": "^3.3.6",
    "typescript": "5.9.3",
    "vitest": "^4.0.18"
  },
  "engines": {
    "node": ">=18.0.0"
  },
  "overrides": {
    "minimatch": "^9.0.7",
    "undici": "^6.23.0"
  }
}
